# Name template for Kata Code Connect source-build identifiers.
# Values live in the 1Password Environment. Do not copy this file to `.env`.
# See docs/operations/environment-variables.md.

# Production Clerk instance. To use your own, get these from the Clerk Dashboard
# under API keys, JWT templates, and OAuth applications.
KATACODE_CLERK_PUBLISHABLE_KEY=pk_live_Y2xlcmsudDMuY29kZXMk
KATACODE_CLERK_JWT_TEMPLATE=kata-relay
KATACODE_CLERK_CLI_OAUTH_CLIENT_ID=hzxSgY2cH10sDU2r

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in KATACODE_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# KATACODE_APPLE_TEAM_ID=ABC1234567
# KATACODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/t3code.provisionprofile
# KATACODE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Production relay. For a self-hosted relay, `infra/relay` deploys update it
# automatically.
KATACODE_RELAY_URL=https://relay.kata.sh

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to https://app.kata.sh; override to test against a staging deployment.
# KATACODE_HOSTED_APP_URL=https://nightly.app.kata.sh

# Public, ingest-only mobile OpenTelemetry configuration.
# KATACODE_MOBILE_OTLP_TRACES_URL=https://api.axiom.co/v1/traces
# KATACODE_MOBILE_OTLP_TRACES_DATASET=kata-code-mobile-traces-dev
# KATACODE_MOBILE_OTLP_TRACES_TOKEN=xaat-...
